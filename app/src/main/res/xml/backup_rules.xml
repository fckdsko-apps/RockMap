<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- User-created RockMap databases remain backup-eligible for reinstall/device recovery. -->
    <!-- Downloadable reference data can be fetched again and must not consume backup quota. -->
    <exclude domain="file" path="maps/" />
    <exclude domain="file" path="research/" />

    <!-- Install/device-local state must never be restored independently of the files it describes. -->
    <exclude domain="sharedpref" path="rockmap_safety.xml" />
    <exclude domain="sharedpref" path="rockmap_initial_setup.xml" />
    <exclude domain="sharedpref" path="rockmap_offline.xml" />
    <exclude domain="sharedpref" path="rockmap_geology_data.xml" />

    <!-- Keep the user's update frequency preference backup-eligible, but not stale scan results. -->
    <exclude domain="sharedpref" path="rockmap_data_update_state.xml" />
</full-backup-content>
