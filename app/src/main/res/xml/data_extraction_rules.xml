<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Downloadable map/research data can be fetched again. User databases remain backup-eligible. -->
        <exclude domain="file" path="maps/" />
        <exclude domain="file" path="research/" />
        <exclude domain="sharedpref" path="rockmap_safety.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="maps/" />
        <exclude domain="file" path="research/" />
        <exclude domain="sharedpref" path="rockmap_safety.xml" />
    </device-transfer>
</data-extraction-rules>
