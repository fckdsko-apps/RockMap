      "id": "rockmap-landuse-green",
      "type": "fill",
      "source": "rockmap-base",
      "source-layer": "landuse",
      "filter": [
        "in",
        "kind",
        "national_park",
        "park",
        "protected_area",
        "nature_reserve",
        "forest",
        "wood",
        "scrub",
        "grassland",
        "grass"
