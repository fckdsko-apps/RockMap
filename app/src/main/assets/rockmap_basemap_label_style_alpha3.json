{
  "version": 8,
  "name": "RockMap Colorado Basemap + Offline Labels Alpha 3",
  "metadata": {
    "rockmap:status": "basemap_test",
    "rockmap:labels": "offline-bundled-alpha3",
    "rockmap:warning": "NOT VERIFIED FOR NAVIGATION. Offline labels are included; land status and mining claims are not included."
