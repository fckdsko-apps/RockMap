    {
      "id": "rockmap-earth",
      "type": "fill",
      "source": "rockmap-base",
      "source-layer": "earth",
      "filter": [
        "==",
        "$type",
        "Polygon"
      ],
      "paint": {
        "fill-color": "#ece8dc"
      }
    },
    {
      "id": "rockmap-landcover",
      "type": "fill",
      "source": "rockmap-base",
      "source-layer": "landcover",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "kind"
          ],
          "forest",
          "#d5dfc8",
          "grassland",
          "#dfe6ca",
          "farmland",
          "#e6e0c3",
          "scrub",
          "#d9dfc9",
          "barren",
          "#e5ddce",
          "glacier",
          "#e8f2f2",
          "urban_area",
          "#e5e1dc",
          "#e1dfd3"
        ],
        "fill-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0.75,
          9,
          0.25
        ]
      }
    },
